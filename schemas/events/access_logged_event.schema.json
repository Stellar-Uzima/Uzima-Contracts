{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccessLoggedEvent",
  "type": "object",
  "properties": {
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    },
    "ledger": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "actor",
    "action",
    "resource",
    "outcome",
    "ledger"
  ],
  "additionalProperties": false
}
