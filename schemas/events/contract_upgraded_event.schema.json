{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractUpgradedEvent",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string"
    },
    "old_version": {
      "type": "integer",
      "minimum": 0
    },
    "new_version": {
      "type": "integer",
      "minimum": 1
    },
    "wasm_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "upgraded_by": {
      "type": "string"
    },
    "ledger": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "contract",
    "new_version",
    "wasm_hash",
    "upgraded_by",
    "ledger"
  ],
  "additionalProperties": false
}
