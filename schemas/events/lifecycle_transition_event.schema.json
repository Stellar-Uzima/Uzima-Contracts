{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifecycleTransitionEvent",
  "type": "object",
  "properties": {
    "old_state": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "new_state": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "ledger": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "old_state",
    "new_state"
  ],
  "additionalProperties": false
}
