{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecordCreatedEvent",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "integer",
      "minimum": 0
    },
    "patient": {
      "type": "string",
      "pattern": "^G[A-Z2-7]{55}$"
    },
    "doctor": {
      "type": "string",
      "pattern": "^G[A-Z2-7]{55}$"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "is_confidential": {
      "type": "boolean"
    },
    "ledger": {
      "type": "integer",
      "minimum": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "record_id",
    "patient",
    "doctor",
    "category",
    "is_confidential",
    "ledger"
  ],
  "additionalProperties": false
}
